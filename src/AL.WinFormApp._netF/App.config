<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>
  <appSettings>
    <!-- DbProvider: SqlServerDb | AccessDb -->
    <add key="DbProvider" value="SqlServerDb" />
  </appSettings>
  <connectionStrings>
    <add name="SqlServerDb"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=JBC_ExploreTheWorld;Trusted_Connection=True;"
         providerName="System.Data.SqlClient" />
    <add name="AccessDb"
         connectionString="C:\Dev\github\JohnBaluka\code-JBC-ExploreTheWorld\VBA\Access\ExploreTheWorld.accdb" />
  </connectionStrings>
</configuration>
