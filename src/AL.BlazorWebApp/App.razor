@namespace JBC.ExploreTheWorld.AL.BlazorWebApp
@using JBC.ExploreTheWorld.AL.BlazorLib
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Radzen

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>ETW BlazorWebApp</title>
    <base href="/" />
    <link rel="stylesheet"
          href="_content/JBC.ExploreTheWorld.AL.BlazorLib/css/app.css" />
    <link rel="stylesheet"
          href="_content/Radzen.Blazor/css/default.css" />
    <link rel="icon"
          type="image/png"
          href="favicon.png" />
    @* Must match the Routes render mode — a static HeadOutlet cannot receive
       PageTitle/HeadContent updates from interactive components. *@
    <HeadOutlet @rendermode="InteractiveAuto" />
</head>
<body>
    <Routes @rendermode="InteractiveAuto" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Colors).Assembly.GetName().Version)"></script>
    @* download-file.js and layout.js are now ESM modules loaded on demand by
       FileDownload__Interop / Layout__Interop (DL.MsJSInterop). *@
</body>
</html>
