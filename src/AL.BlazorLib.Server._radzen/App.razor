@namespace JBC.ExploreTheWorld.AL.BlazorLib.Server
@using JBC.ExploreTheWorld.AL.BlazorLib
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Radzen
@using Radzen.Blazor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>ETW BlazorLib._radzen</title>
    <base href="/" />
    @* Radzen theme via the RadzenTheme component (loads the complete free default-base.css,
       icon @font-face included). Radzen Blazor Studio reads this component to apply the same
       theme in its design-time preview — a raw <link> is ignored by the preview renderer. *@
    <RadzenTheme Theme="default" />
    <link rel="stylesheet"
          href="_content/JBC.ExploreTheWorld.AL.BlazorLib._radzen/css/app.css" />
    <link rel="icon"
          type="image/png"
          href="favicon.png" />
    @* Must match the Routes render mode — a static HeadOutlet cannot receive
       PageTitle/HeadContent updates from interactive components. *@
    <HeadOutlet @rendermode="InteractiveAuto" />
</head>
<body>
    <Routes @rendermode="InteractiveAuto" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Colors).Assembly.GetName().Version)"></script>
    @* download-file.js and layout.js are now ESM modules loaded on demand by
       FileDownload__Interop / Layout__Interop (DL.MsJSInterop). *@
</body>
</html>
