<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet"
          href="@Assets["/css/app.css"]" />
    <link rel="stylesheet"
          href="@Assets["ExploreTheWorld.AL.MsOfficeWordBlazorWebAddIn.styles.css"]" />
    <ImportMap />
    <link rel="icon"
          type="image/png"
          href="/Images/favicon.png" />

    <link rel="stylesheet"
          href="_content/Radzen.Blazor/css/default.css" />

    <script type="text/javascript">
        // Fix: Office.js deletes window.history.pushState and window.history.replaceState. Cache and restore them.
        // See https://learn.microsoft.com/en-us/answers/questions/1150659/uncaught-typeerror-history-pushstate-is-not-a-func
        window._historyCache = {
            replaceState: window.history.replaceState,
            pushState: window.history.pushState
        };
    </script>

    <script type="text/javascript"
            src="https://appsforoffice.microsoft.com/lib/1/hosted/office.js"></script>

    <script type="text/javascript">
        // Restore pushState/replaceState after Office.js loads
        window.history.replaceState = window._historyCache.replaceState;
        window.history.pushState = window._historyCache.pushState;
    </script>

    <HeadOutlet />
</head>

@using ExploreTheWorld.AL.MsOfficeWordBlazorWebAddIn.Client.Components

<body>
    <Routes />
    @* Bridge components register DotNetObjectReference handlers with JavaScript *@
    <WasmBridge />
    <ServerBridge />

    @* getWindowWidth / watchWindowWidth are provided by Layout__Interop (DL.MsJSInterop)
       as an ESM module; RenderModeInfo injects the interop instead of using globals. *@

    <script type="text/javascript">
        // Global bridge infrastructure: must load before blazor.web.js so that
        // both Server and WebAssembly interactive runtimes can call signalDotNetReady.
        (function () {
            console.log("[bridge] Initializing bridge infrastructure");
            var dotNetRefs = new Map();
            var resolvers = {};

            window.dotNetReady = {
                wasm: new Promise(function (resolve) { resolvers.wasm = resolve; }),
                server: new Promise(function (resolve) { resolvers.server = resolve; })
            };
            window.dotNetRefs = dotNetRefs;

            window.signalDotNetReady = function (name, dotNetRef) {
                console.log("[bridge] signalDotNetReady: " + name + " bridge ready");
                dotNetRefs.set(name, dotNetRef);
                if (resolvers[name]) {
                    console.log("[bridge] Resolving " + name + " promise");
                    resolvers[name]();
                } else {
                    console.warn("[bridge] No resolver found for: " + name);
                }
            };
            console.log("[bridge] Infrastructure ready, waiting for bridges");
        })();
    </script>

    <script src="_framework/blazor.web.js"></script>
    <script src="./commands/commands.js"
            type="text/javascript"></script>
</body>

</html>
