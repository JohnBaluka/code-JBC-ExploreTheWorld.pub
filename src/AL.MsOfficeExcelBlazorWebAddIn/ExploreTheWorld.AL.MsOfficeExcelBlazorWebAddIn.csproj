<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetOfficeVersion>15.0</TargetOfficeVersion>
    <AssemblyName>ExploreTheWorld.AL.MsOfficeExcelBlazorWebAddIn</AssemblyName>
    <RootNamespace>ExploreTheWorld.AL.MsOfficeExcelBlazorWebAddIn</RootNamespace>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AL.MsOfficeExcelBlazorWebAddIn.Client\ExploreTheWorld.AL.MsOfficeExcelBlazorWebAddIn.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.9" />
    <PackageReference Include="Radzen.Blazor" Version="11.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="..\AL.MsOfficeExcelBlazorWebAddIn.Client\package.json" />
    <Content Remove="..\AL.MsOfficeExcelBlazorWebAddIn.Client\package-lock.json" />
    <Content Remove="..\AL.MsOfficeExcelBlazorWebAddIn.Client\node_modules\**\*" />
  </ItemGroup>

  <Target Name="NpmRestore" BeforeTargets="BeforeBuild;ResolveReferences" Condition="Exists('package.json')">
    <PropertyGroup>
      <NpmStampFile>node_modules/.package-lock.stamp</NpmStampFile>
      <NpmRestoreNeeded Condition="!Exists('$(NpmStampFile)')">true</NpmRestoreNeeded>
      <_PackageLockTime Condition="Exists('package-lock.json') AND Exists('$(NpmStampFile)')">$([System.IO.File]::GetLastWriteTime('package-lock.json').Ticks)</_PackageLockTime>
      <_StampTime Condition="Exists('package-lock.json') AND Exists('$(NpmStampFile)')">$([System.IO.File]::GetLastWriteTime('$(NpmStampFile)').Ticks)</_StampTime>
      <NpmRestoreNeeded Condition="'$(_PackageLockTime)' != '' AND '$(_StampTime)' != '' AND $(_PackageLockTime) &gt; $(_StampTime)">true</NpmRestoreNeeded>
    </PropertyGroup>
    <Message Importance="high" Text="Running npm install (package-lock.json updated or first build)..." Condition="'$(NpmRestoreNeeded)' == 'true'" />
    <Exec Command="npm install" Condition="'$(NpmRestoreNeeded)' == 'true'" ConsoleToMSBuild="true" />
    <Touch Files="$(NpmStampFile)" AlwaysCreate="true" Condition="'$(NpmRestoreNeeded)' == 'true'" />
    <Message Importance="low" Text="Skipping npm install - packages are up to date" Condition="'$(NpmRestoreNeeded)' != 'true'" />
  </Target>

</Project>
