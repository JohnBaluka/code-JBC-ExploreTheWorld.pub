<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JBC.ExploreTheWorld.AL.MauiLib</RootNamespace>
    <AssemblyName>JBC.ExploreTheWorld.AL.MauiLib</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
    <!-- Compile-time only: the platform heads reference this package themselves; excluding the
         build assets here keeps its static web assets from being contributed twice. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.80" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AL.BlazorLib\ExploreTheWorld.AL.BlazorLib.csproj" />
    <ProjectReference Include="..\AL\ExploreTheWorld.AL.csproj" />
    <ProjectReference Include="..\BL\ExploreTheWorld.BL.csproj" />
    <ProjectReference Include="..\CL\ExploreTheWorld.CL.csproj" />
    <ProjectReference Include="..\DL\ExploreTheWorld.DL.csproj" />
    <ProjectReference Include="..\DL.MsJSInterop\ExploreTheWorld.DL.MsJSInterop.csproj" />
    <ProjectReference Include="..\DL.MsJSInterop.RevealJs\ExploreTheWorld.DL.MsJSInterop.RevealJs.csproj" />
  </ItemGroup>

</Project>
