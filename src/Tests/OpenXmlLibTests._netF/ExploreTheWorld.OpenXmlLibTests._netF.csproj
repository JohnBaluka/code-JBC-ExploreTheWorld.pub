<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JBC.ExploreTheWorld.OpenXmlLibTests._netF</AssemblyName>
    <RootNamespace>JBC.ExploreTheWorld.OpenXmlLibTests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- FluentAssertions 6.x is the last series with .NET Framework support. -->
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CL._netF\ExploreTheWorld.CL._netF.csproj" />
    <ProjectReference Include="..\..\DL._netF\ExploreTheWorld.DL._netF.csproj" />
    <ProjectReference Include="..\..\DL.MsOfficeApi.OpenXml_Impl._netF\ExploreTheWorld.DL.MsOfficeApi.OpenXml_Impl._netF.csproj" />
  </ItemGroup>

  <!-- Link shared test source from OpenXmlLibTests (shared-link compilation pattern). -->
  <ItemGroup>
    <Compile Include="..\OpenXmlLibTests\**\*.cs">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="..\OpenXmlLibTests\obj\**" />
    <Compile Remove="..\OpenXmlLibTests\bin\**" />
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

</Project>
