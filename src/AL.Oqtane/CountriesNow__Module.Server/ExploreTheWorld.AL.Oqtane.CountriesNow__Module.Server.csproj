<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JBC.ExploreTheWorld.AL.Oqtane.CountriesNow__Module.Server</AssemblyName>
    <RootNamespace>JBC.ExploreTheWorld.AL.Oqtane.CountriesNow</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: Oqtane.Shared is already in Oqtane.Server/bin. -->
    <ProjectReference Include="..\..\..\oqtane.framework\Oqtane.Shared\Oqtane.Shared.csproj" Private="false" />
    <!-- Pulls CountriesNow__Module.Client and all its dependencies (AL.BlazorLib, etc.) into /bin. -->
    <ProjectReference Include="..\CountriesNow__Module.Client\ExploreTheWorld.AL.Oqtane.CountriesNow__Module.Client.csproj" />
    <!-- ETW service stack for DI registration -->
    <ProjectReference Include="..\..\DL.CountriesNowSpaceData.SqlServerDb_Impl\ExploreTheWorld.DL.CountriesNowSpaceData.SqlServerDb_Impl.csproj" />
    <ProjectReference Include="..\..\DL.CountriesNowSpaceApi\ExploreTheWorld.DL.CountriesNowSpaceApi.csproj" />
    <ProjectReference Include="..\..\BL\ExploreTheWorld.BL.csproj" />
    <!-- AL.BlazorLib provides BrowserExport_AppService (OfficeExport_AppService__Interface impl). -->
    <ProjectReference Include="..\..\AL.BlazorLib\ExploreTheWorld.AL.BlazorLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
  </ItemGroup>

</Project>
