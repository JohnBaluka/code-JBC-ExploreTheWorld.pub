<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JBC.ExploreTheWorld.AL.Oqtane.CountrySlides__Module.Client</AssemblyName>
    <RootNamespace>JBC.ExploreTheWorld.AL.Oqtane.CountrySlides</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: Oqtane assemblies are already in Oqtane.Server/bin. -->
    <ProjectReference Include="..\..\..\oqtane.framework\Oqtane.Shared\Oqtane.Shared.csproj" Private="false" />
    <ProjectReference Include="..\..\..\oqtane.framework\Oqtane.Client\Oqtane.Client.csproj" Private="false" />
    <!-- AL.BlazorLib contains CountrySlides__Component; its DLL must be in /bin. -->
    <ProjectReference Include="..\..\AL.BlazorLib\ExploreTheWorld.AL.BlazorLib.csproj" />
  </ItemGroup>

</Project>
