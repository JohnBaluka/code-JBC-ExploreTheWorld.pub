<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JBC.ExploreTheWorld.AL.ExportData.ConsoleApp</AssemblyName>
    <RootNamespace>JBC.ExploreTheWorld.AL.ExportData.ConsoleApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BL\ExploreTheWorld.BL.csproj" />
    <ProjectReference Include="..\CL\ExploreTheWorld.CL.csproj" />
    <ProjectReference Include="..\DL\ExploreTheWorld.DL.csproj" />
    <ProjectReference Include="..\DL.CountriesNowSpaceApi\ExploreTheWorld.DL.CountriesNowSpaceApi.csproj" />
    <ProjectReference Include="..\DL.CountriesNowSpaceData.SqliteDb_Impl\ExploreTheWorld.DL.CountriesNowSpaceData.SqliteDb_Impl.csproj" />
    <ProjectReference Include="..\DL.CountriesNowSpaceData.SqlServerDb_Impl\ExploreTheWorld.DL.CountriesNowSpaceData.SqlServerDb_Impl.csproj" />
    <ProjectReference Include="..\DL.CountriesNowSpaceData.InMemoryDb_Impl\ExploreTheWorld.DL.CountriesNowSpaceData.InMemoryDb_Impl.csproj" />
    <ProjectReference Include="..\DL.CountriesNowSpaceData.AccessDb_Impl\ExploreTheWorld.DL.CountriesNowSpaceData.AccessDb_Impl.csproj" />
    <!-- Office export factory + DL repo _Impl references come from the shared composition project
         (the same one the WinForms/MAUI hosts use) instead of a hand-copied factory. -->
    <ProjectReference Include="..\DL.MsOfficeApi_Impl\ExploreTheWorld.DL.MsOfficeApi_Impl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
