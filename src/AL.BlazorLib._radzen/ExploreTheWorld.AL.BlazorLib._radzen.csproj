<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- Base namespace (no _radzen suffix) so copied .razor components share the namespace
         of their .razor.cs code-behind partials (mirrors AL.BlazorLib). -->
    <RootNamespace>JBC.ExploreTheWorld.AL.BlazorLib</RootNamespace>
    <AssemblyName>JBC.ExploreTheWorld.AL.BlazorLib._radzen</AssemblyName>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" Version="11.1.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.9" />
  </ItemGroup>

  <!-- Project references mirror AL.BlazorLib (so the synchronized .razor/.cs copies compile)
       plus the browser DB providers the WASM host registers (see Program.cs). -->
  <ItemGroup>
    <ProjectReference Include="..\AL\ExploreTheWorld.AL.csproj" />
    <ProjectReference Include="..\BL\ExploreTheWorld.BL.csproj" />
    <ProjectReference Include="..\CL\ExploreTheWorld.CL.csproj" />
    <ProjectReference Include="..\DL\ExploreTheWorld.DL.csproj" />
    <ProjectReference Include="..\DL.CountriesNowSpaceApi\ExploreTheWorld.DL.CountriesNowSpaceApi.csproj" />
    <ProjectReference Include="..\DL.MsJSInterop\ExploreTheWorld.DL.MsJSInterop.csproj" />
    <ProjectReference Include="..\DL.MsJSInterop.RevealJs\ExploreTheWorld.DL.MsJSInterop.RevealJs.csproj" />
    <ProjectReference Include="..\DL.MsOfficeApi.OpenXml_Impl\ExploreTheWorld.DL.MsOfficeApi.OpenXml_Impl.csproj" />
    <ProjectReference Include="..\DL.CountriesNowSpaceData.InMemoryDb_Impl\ExploreTheWorld.DL.CountriesNowSpaceData.InMemoryDb_Impl.csproj" />
    <ProjectReference Include="..\DL.CountriesNowSpaceData.LocalStorageDb_Impl\ExploreTheWorld.DL.CountriesNowSpaceData.LocalStorageDb_Impl.csproj" />
    <ProjectReference Include="..\DL.CountriesNowSpaceData.SessionStorageDb_Impl\ExploreTheWorld.DL.CountriesNowSpaceData.SessionStorageDb_Impl.csproj" />
    <ProjectReference Include="..\DL.CountriesNowSpaceData.IndexedDb_Impl\ExploreTheWorld.DL.CountriesNowSpaceData.IndexedDb_Impl.csproj" />
  </ItemGroup>

</Project>
