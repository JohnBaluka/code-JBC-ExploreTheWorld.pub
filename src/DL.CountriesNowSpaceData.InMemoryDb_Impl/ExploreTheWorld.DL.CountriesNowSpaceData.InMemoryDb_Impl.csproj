<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>JBC.ExploreTheWorld.DL.CountriesNowSpaceData.InMemoryDb_Impl</AssemblyName>
    <RootNamespace>JBC.ExploreTheWorld.DL.CountriesNowSpaceData.InMemoryDb_Impl</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DL.CountriesNowSpaceData\ExploreTheWorld.DL.CountriesNowSpaceData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-memory provider — no external database required. Suitable for development,
         demos, and unit/integration tests. Data is lost when the process exits. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
  </ItemGroup>

</Project>
