<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JBC.ExploreTheWorld.DL.MsOfficeApi.Interop_Impl._netF</AssemblyName>
    <RootNamespace>JBC.ExploreTheWorld.DL.MsOfficeApi.Interop_Impl</RootNamespace>
  </PropertyGroup>

  <!-- Microsoft.Office.Core (office.dll, v15.0.0.0) has no NuGet package; reference the matching
       PIA present on any Office/VSTO dev machine (GAC first, VSTO Shared PIA folder fallback). -->
  <PropertyGroup>
    <_OfficePiaGac>$(WINDIR)\assembly\GAC_MSIL\office\15.0.0.0__71e9bce111e9429c\office.dll</_OfficePiaGac>
    <_OfficePiaVsto>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Shared\Visual Studio Tools for Office\PIA\Office15\Office.dll</_OfficePiaVsto>
    <OfficePiaPath Condition="Exists('$(_OfficePiaGac)')">$(_OfficePiaGac)</OfficePiaPath>
    <OfficePiaPath Condition="'$(OfficePiaPath)' == '' And Exists('$(_OfficePiaVsto)')">$(_OfficePiaVsto)</OfficePiaPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CL._netF\ExploreTheWorld.CL._netF.csproj" />
    <ProjectReference Include="..\DL._netF\ExploreTheWorld.DL._netF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Office.Interop.Word" Version="15.0.4797.1004" />
    <!-- Keep Excel on 15.x (assembly 15.0.0.0) — a 16.x package pulls office 16.0.0.0 and
         breaks the office 15.0.0.0 reference below (CS1705). -->
    <PackageReference Include="Microsoft.Office.Interop.Excel" Version="15.0.4795.1000" />
    <PackageReference Include="Microsoft.Office.Interop.PowerPoint" Version="15.0.4420.1018" />
    <PackageReference Include="stdole" Version="17.14.40260" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="office">
      <HintPath>$(OfficePiaPath)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\DL.MsOfficeApi.Interop_Impl\**\*.cs">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="..\DL.MsOfficeApi.Interop_Impl\obj\**" />
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

</Project>
